<Project>
  <PropertyGroup>
    <RevitApiPath>C:\Program Files\Autodesk\Revit 2026</RevitApiPath>
    <LocalRevitApiPath>$(MSBuildThisFileDirectory)..\store</LocalRevitApiPath>
    <RevitApiPath Condition="Exists('$(LocalRevitApiPath)\RevitAPI.dll')">$(LocalRevitApiPath)</RevitApiPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
