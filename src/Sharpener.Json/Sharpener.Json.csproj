<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Sharpener.Json</PackageId>
    <Description>Quality of life tools for C# JSON with syntactical extensions and configurability.</Description>
    <PackageReadmeFile>JSON.md</PackageReadmeFile>
    <PackageTags>quality-of-life qol json serialization dotnet csharp</PackageTags>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <SharedPackageVersion>1.0.1</SharedPackageVersion>
    <AssemblyVersion>$(SharedPackageVersion)</AssemblyVersion>
    <FileVersion>$(SharedPackageVersion)</FileVersion>
    <InformationalVersion>$(SharedPackageVersion)+$(GitCommitId)</InformationalVersion>
    <Version>$(SharedPackageVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\docs\JSON.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
      <Link>Docs\README.md</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Docs\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sharpener\Sharpener.csproj"/>
  </ItemGroup>
</Project>
