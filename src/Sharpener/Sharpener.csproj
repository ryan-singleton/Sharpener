<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Sharpener</PackageId>
    <Description>Quality of life tools for C# including string case insensitive syntax and left join linq for collections.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>quality-of-life qol dotnet csharp</PackageTags>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <SharedPackageVersion>1.0.4</SharedPackageVersion>
    <AssemblyVersion>$(SharedPackageVersion)</AssemblyVersion>
    <FileVersion>$(SharedPackageVersion)</FileVersion>
    <InformationalVersion>$(SharedPackageVersion)+$(GitCommitId)</InformationalVersion>
    <Version>$(SharedPackageVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
      <Link>Docs\README.md</Link>
    </None>
  </ItemGroup>
</Project>
